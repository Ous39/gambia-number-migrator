NODE_ENV=development
API_PORT=8089
DATABASE_URL=postgres://gnm_user:gnm_password@localhost:5434/gambia_number_migrator
POSTGRES_PASSWORD=gnm_password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# --- Payments: global switches -------------------------------------------------
# PAYMENT_TEST_MODE=true uses a locally generated OTP and NEVER contacts Wave.
# It must be false in production (apps/api/src/config/env.ts enforces this).
PAYMENT_TEST_MODE=true
# Master switch for live provider calls. Leave false until a provider is fully
# onboarded, credentialed and end-to-end tested. When true in production the API
# refuses to boot unless the Wave configuration below is complete.
PAYMENT_PROVIDER_INTEGRATION_READY=false

# --- Wave Checkout (server-only) --------------------------------------------------
# NEVER place these in Expo env, mobile source, CI logs, tests or docs. They live
# only in the production backend / VPS .env.production file (git-ignored).
WAVE_API_BASE_URL=https://api.wave.com
WAVE_API_KEY=
WAVE_API_SIGNING_SECRET=
WAVE_WEBHOOK_SECRET=
# Optional: set only during webhook-secret rotation (old secret), then remove.
WAVE_WEBHOOK_SECRET_PREVIOUS=
# EXPECTED value pending WRITTEN Wave confirmation that the Checkout API accepts
# GMD for a Gambia business wallet. Wave's public examples use XOF. The live path
# stays disabled until this is set AND equals app_config.currency.
WAVE_CURRENCY=GMD
WAVE_SUCCESS_URL=https://gnm.oceanbrown.gm/payment/success
WAVE_ERROR_URL=https://gnm.oceanbrown.gm/payment/error
WAVE_REQUEST_TIMEOUT_MS=10000
# Max accepted webhook age in seconds. Wave's fixed rule is 300 (5 minutes);
# lowering is fine, raising above 300 has no effect on Wave.
WAVE_WEBHOOK_TOLERANCE_SECONDS=300
# Forward the payer's number to Wave as restrict_payer_mobile (E.164). Off by
# default; only enable if Wave confirms the field is supported for GMD checkouts.
WAVE_ENABLE_PAYER_RESTRICTION=false

# --- APS (separate provider; interim scheme) ---------------------------------
APS_WEBHOOK_SECRET=

# Back-compat alias for WAVE_WEBHOOK_TOLERANCE_SECONDS (WAVE_ one wins if both set).
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

EXPO_ACCESS_TOKEN=
# Optional: public HTTPS origin of this API (used only to sanity-check the Wave enable-guard).
PUBLIC_API_BASE_URL=https://api.oceanbrown.gm/api
UPLOAD_DIR=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ADMIN_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8089/api
VITE_PLAY_STORE_URL=
VITE_APP_STORE_URL=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8089/api
EXPO_PUBLIC_EAS_PROJECT_ID=2f1a4344-3c29-466d-a773-56355f9d4994
EXPO_PUBLIC_DISTRIBUTION_CHANNEL=direct
EXPO_PUBLIC_PAYMENT_TEST_MODE=true
EXPO_PUBLIC_SUPPORT_EMAIL=info.oceanbrown@gmail.com
EXPO_PUBLIC_SUPPORT_PHONE=+2203631776
EXPO_PUBLIC_SUPPORT_WHATSAPP=2203631776
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://gnm.oceanbrown.gm/privacy
EXPO_PUBLIC_TERMS_URL=https://gnm.oceanbrown.gm/terms
