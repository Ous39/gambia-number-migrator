# Backend
NODE_ENV=development
API_PORT=8089
DATABASE_URL=postgres://gnm_user:gnm_password@localhost:5434/gambia_number_migrator
JWT_SECRET=change-this-in-production
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password
PAYMENT_TEST_MODE=true
# Live merchant keys are backend-only. Never prefix these with EXPO_PUBLIC_.
WAVE_API_KEY=
WAVE_API_BASE_URL=https://api.wave.com
WAVE_WEBHOOK_SECRET=
APS_MERCHANT_ID=
APS_API_KEY=
APS_API_BASE_URL=
APS_WEBHOOK_SECRET=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ADMIN_BASE_URL=http://localhost:5173

# Admin
VITE_API_BASE_URL=http://localhost:8089/api

# Mobile
# For Expo Go on a real phone, use your PC LAN IP, not localhost.
# Example: EXPO_PUBLIC_API_BASE_URL=http://172.16.50.144:8089/api
# The mobile app also auto-detects the Expo LAN host when this is left as localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8089/api
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_DISTRIBUTION_CHANNEL=direct
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.gm/privacy
EXPO_PUBLIC_TERMS_URL=https://your-domain.gm/terms
